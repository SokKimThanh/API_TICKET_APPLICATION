@hostname = localhost
@port = 5925
@baseUrl = https://{{hostname}}:{{port}}

###############################################################################
# REQUEST FILE: request_movies.http
###############################################################################

# ============================================================================
# 1. GET ALL MOVIES - Anonymous access
# ============================================================================

### 1.1 Get all movies (paged)
GET {{baseUrl}}/api/movies?pageNumber=1&pageSize=10
Accept: application/json

# ============================================================================
# 2. GET MOVIE BY ID - Anonymous access
# ============================================================================

### 2.1 Get movie by ID
GET {{baseUrl}}/api/movies/1
Accept: application/json

# ============================================================================
# 3. CREATE MOVIE - Admin only
# ============================================================================

### 3.1 Create movie
POST {{baseUrl}}/api/movies
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Interstellar",
  "description": "A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival.",
  "genre": "Sci-Fi",
  "durationInMinutes": 169,
  "posterUrl": "https://example.com/interstellar.jpg",
  "releaseDate": "2014-11-07"
}

# ============================================================================
# 4. UPDATE MOVIE - Admin only
# ============================================================================

### 4.1 Update movie
PUT {{baseUrl}}/api/movies/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Interstellar - Updated",
  "description": "Updated description",
  "genre": "Sci-Fi",
  "durationInMinutes": 175,
  "posterUrl": "https://example.com/interstellar-updated.jpg",
  "releaseDate": "2014-11-07"
}

# ============================================================================
# 5. PARTIAL UPDATE MOVIE - Admin only
# ============================================================================

### 5.1 Patch movie
PATCH {{baseUrl}}/api/movies/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "genre": "Epic Sci-Fi"
}

# ============================================================================
# 6. DELETE MOVIE - Admin only
# ============================================================================

### 6.1 Delete movie
DELETE {{baseUrl}}/api/movies/1
Authorization: Bearer {{authToken}}
Accept: application/json
