@hostname = localhost
@port = 5925
@baseUrl = https://{{hostname}}:{{port}}

###############################################################################
# REQUEST FILE: request_bookings_tickets.http
###############################################################################

# ============================================================================
# 1. BOOKINGS
# ============================================================================

### 1.1 Create Booking
POST {{baseUrl}}/api/bookings
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "showtimeId": 1,
  "seatIds": [1, 2]
}

### 1.2 Get all bookings (User sees own, Admin sees all)
GET {{baseUrl}}/api/bookings?pageNumber=1&pageSize=10
Authorization: Bearer {{authToken}}
Accept: application/json

### 1.3 Get booking by ID
GET {{baseUrl}}/api/bookings/1
Authorization: Bearer {{authToken}}
Accept: application/json

### 1.4 Update booking status (Admin only)
PUT {{baseUrl}}/api/bookings/1/status
Authorization: Bearer {{authToken}}
Content-Type: application/json

"Completed"

### 1.5 Cancel booking
DELETE {{baseUrl}}/api/bookings/1
Authorization: Bearer {{authToken}}
Accept: application/json

# ============================================================================
# 2. TICKETS
# ============================================================================

### 2.1 Get all tickets
GET {{baseUrl}}/api/tickets?pageNumber=1&pageSize=20
Authorization: Bearer {{authToken}}
Accept: application/json

### 2.2 Get ticket by ID
GET {{baseUrl}}/api/tickets/1
Authorization: Bearer {{authToken}}
Accept: application/json
